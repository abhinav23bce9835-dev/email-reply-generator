# LLM Configuration
LLM_PROVIDER=mock
MODEL_NAME=mock-llm-v1

# Vector Database
VECTOR_DB_TYPE=chroma
CHROMA_PERSIST_DIR=./chroma_data
COLLECTION_NAME=email_collection
EMBEDDING_MODEL=all-MiniLM-L6-v2

# RAG Settings
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.3
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Generation Settings
TEMPERATURE=0.7
MAX_TOKENS=512
DEFAULT_TONE=formal

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
