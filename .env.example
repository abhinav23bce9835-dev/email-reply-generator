# ===================================================
# RAG Email Reply Generator - Environment Variables
# ===================================================

# LLM Configuration
# Options: openai, ollama, mock
LLM_PROVIDER=mock

# OpenAI (required only if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Ollama (required only if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Model name (for openai: gpt-3.5-turbo, gpt-4; for ollama: llama2, mistral)
MODEL_NAME=gpt-3.5-turbo

# Vector Database Configuration
# Options: chroma, faiss
VECTOR_DB_TYPE=chroma

# Embedding model (sentence-transformers model name)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB persistence directory
CHROMA_PERSIST_DIR=./chroma_data

# Collection name in vector DB
COLLECTION_NAME=email_knowledge_base

# RAG Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RESULTS=5

# LLM Generation Parameters
TEMPERATURE=0.7
MAX_TOKENS=500

# Default email tone (formal, friendly, concise)
DEFAULT_TONE=formal

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
